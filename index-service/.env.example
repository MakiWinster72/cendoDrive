# 文档索引服务配置示例。复制为 .env 后按需修改。
# 全部配置均可通过 INDEX_ 前缀的环境变量覆盖。

# 本地状态存储（幂等键、revision、分块中间结构）
INDEX_DATABASE_PATH=./data/index-service.sqlite3

# 文件来源：local 仅用于自测；fastdfs 待 Lucky 提供连接信息后接入（TODO(contract)）
INDEX_SOURCE_KIND=local
INDEX_LOCAL_SOURCE_ROOT=./data/files

# 解析与分块（对应 docs/文档索引服务对接说明.md 第 7 节）
INDEX_CHUNK_SIZE=800
INDEX_CHUNK_OVERLAP=100
INDEX_MAX_FILE_BYTES=52428800
INDEX_MAX_PDF_PAGES=1000
INDEX_PARSE_TIMEOUT_SECONDS=120

# 内部重试（对应第 6 节）
INDEX_MAX_ATTEMPTS=12
INDEX_FILE_MISSING_MAX_ATTEMPTS=3
INDEX_RETRY_BACKOFF_SECONDS=30,60,300,900,1800,3600,7200,21600,43200,43200,43200
INDEX_WORKER_POLL_SECONDS=1.0
INDEX_WORKER_BATCH=20
